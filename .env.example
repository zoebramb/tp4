# Puerto donde corre el servidor HTTP, WebSocket y SSE
PORT=3000

# URL base del catálogo externo (DummyJSON)
CATALOG_BASE_URL=https://dummyjson.com/products

# Tiempo máximo de espera (en milisegundos) por cada consulta al catálogo
CATALOG_TIMEOUT_MS=3000

# Demora artificial (en milisegundos) para simular un catálogo lento (0 = sin demora)
CATALOG_DELAY_MS=0